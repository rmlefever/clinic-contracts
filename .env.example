APP_URL=http://localhost:4321
PORT=4321
DATABASE_PATH=./data/contracts.sqlite
UPLOAD_DIR=./uploads
STORAGE_DIR=./storage
ADMIN_TOKEN=change-me
RESEND_API_KEY=
EMAIL_FROM=DocuSeal <signing@docuseal.ink>
# LOG_LEVEL=info                # fastify/pino level; tests use silent

# Evidence hardening (all optional; defaults shown)
# SIGNING_TOKEN_DAYS=30        # signing-link expiry
# SIGNER_OTP_ENABLED=true      # signer email verification (needs RESEND_API_KEY)
# OTP_TTL_MINUTES=10
# OTP_RESEND_THROTTLE_SECONDS=30
# OTP_MAX_ATTEMPTS=5
# SIGNER_SESSION_HOURS=2

# Outbound webhook (single consumer: the Cardinal Framework). Operator-set only;
# no API can change these. Payloads carry no patient data; deliveries are
# HMAC-signed (X-Contracts-Signature: "{unix_ts}.{hmac_sha256}") with a 5-min window.
# WEBHOOK_URL=https://promisframework.com/api/webhooks/contracts
# WEBHOOK_SECRET=<generate: openssl rand -base64 24>

# Automatic reminders for pending contracts (hourly sweep)
# REMINDER_ENABLED=true
# REMINDER_AFTER_DAYS=3
# REMINDER_INTERVAL_DAYS=7
